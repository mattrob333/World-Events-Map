# Production builds ship the LABELLED demo until real accounts exist (Phase 2).
# NODE_ENV=production would otherwise default demo mode off and present a globe
# with no members, groups or conversations. With this set, every simulated
# surface carries "Demo — simulated members and activity" in the masthead and
# "Simulated for review" on records. Remove this line to ship real mode.
NEXT_PUBLIC_MERIDIAN_DEMO=1
