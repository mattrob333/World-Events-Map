# Copy to .env.local; rebuild after changing NEXT_PUBLIC_ values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_MERIDIAN_DEMO=0
# Generate distinct long random secrets for scheduler and manual refresh.
CRON_SECRET=
REFRESH_ADMIN_TOKEN=
# Optional live sources. Scheduler configuration is required: docs/LIVE-SETUP.md.
TICKETMASTER_API_KEY=
PREDICTHQ_TOKEN=
X_BEARER_TOKEN=
X_POSTS_ENABLED=0
SERPAPI_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# NOW decision engine. Server only. Never expose these keys in NEXT_PUBLIC_ variables.
BESTTIME_API_KEY_PRIVATE=
# Signs the per-place tokens Vibe Now hands the map (live checks, Google details).
# Generate a long random value (e.g. `openssl rand -base64 48`). Unset falls back
# to the BestTime key; setting or changing it invalidates tokens already issued.
NOW_TOKEN_SECRET=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Daily editorial research. Both vendor tokens are server-only. No paid search
# occurs on public page requests; the authorized cron owns the fixed query plan.
EXA_API_KEY=
TREG_TOKEN=
# Only used by scripts/refresh-feeds.mjs.
APP_BASE_URL=http://localhost:3127
